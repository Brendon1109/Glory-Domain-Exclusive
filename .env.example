# --- Database (Neon Postgres) ---
# Pooled connection string used by the app at runtime (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string, used ONLY for drizzle-kit migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
# Secret for encrypting iron-session cookies. MUST be at least 32 characters.
SESSION_SECRET="please-change-this-to-a-long-random-string-of-32-plus-characters"
# Pastor's admin password (used at /admin/login). Choose something strong.
ADMIN_PASSWORD="change-me"

# --- Media uploads (Vercel Blob) ---
# Auto-set when you create a Blob store in the Vercel dashboard (Storage → Blob).
# Needed for the pastor to upload sermon audio/video that plays in the background.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
